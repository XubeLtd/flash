{
  "name": "flash",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "latest",
    "@types/inquirer": "^9.0.10",
    "@types/unzipper": "^0.10.11",
    "@types/which": "^3.0.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@xube/device-toolkit": "workspace:*",
    "adm-zip": "^0.5.18",
    "openapi-zod-client": "^1.18.3",
    "openapi3-ts": "^4.6.1",
    "ora": "^8.2.0",
    "unzipper": "^0.12.5",
    "zod": "^3.25.76",
    "zodios": "^5.1.0",
    "which": "latest"
  },
  "scripts": {
    "flash": "bun run src/provision.ts",
    "push": "bun run src/push.ts",
    "monitor": "bun run src/monitor.ts",
    "setup": "bun run src/setup.ts",
    "build:toolkit": "tsc -p packages/device-toolkit/tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "generate:sdk": "bun run generate:prod && bun run generate:dev",
    "generate:prod": "bun run ./scripts/generate-xube-sdk.ts generate prod ./src/sdk",
    "generate:dev": "bun run ./scripts/generate-xube-sdk.ts generate dev ./src/sdk"
  }
}
